# ---------------------------------------------------------------------------
# Required. These four need real values before the app will run.
# ---------------------------------------------------------------------------

DATABASE_URL="postgresql://dogathon:dogathon@localhost:5432/dogathon?schema=public"

# At least 32 random characters. Signs sessions.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"

# Also the base for Stripe Checkout success/cancel URLs.
BETTER_AUTH_URL="http://localhost:3000"

# 32 random bytes, base64: openssl rand -base64 32
# Encrypts per-organization email credentials at rest. This is a LOCAL key, not
# an external credential, so unlike everything below it should be present.
# Unset, sending falls back to a described send (hasEncryptionKey guards
# sendThroughConnector), but SAVING a connector throws -- encryptEmailSecret
# has no key to encrypt the OAuth tokens or SMTP password with.
EMAIL_CONNECTOR_ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Optional. Sensible defaults; override only if you mean to.
# ---------------------------------------------------------------------------

# JSON webhook receiving {to, subject, invitationUrl, role}.
# Unset -> development invitation links are logged to the server console.
INVITATION_EMAIL_WEBHOOK_URL=""

OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
FIRECRAWL_BASE_URL="https://api.firecrawl.dev/v2"

# "common" for work/school and personal Microsoft accounts, or a tenant ID.
MICROSOFT_TENANT_ID="common"

# ---------------------------------------------------------------------------
# Credentials. Every key below is intentionally empty.
#
# This codebase branches on whether a credential is PRESENT, not whether it is
# valid -- an absent key means "describe the call, do not make it". Never fill
# these with shaped-but-invalid placeholders like sk_test_replace_me: a present
# key makes the code attempt the endpoint and fail at auth instead, which is
# the live call the empty value exists to prevent.
# ---------------------------------------------------------------------------

# --- Model access (OpenAI-compatible) ---
# Unset -> the completion is described rather than requested.
OPENAI_API_KEY=""

# --- Firecrawl (direct API) ---
# Unset -> scrape/map return a dry-run description and roster sync uses the
# bundled dogs-page-A.html capture with usedFallbackCapture: true.
FIRECRAWL_API_KEY=""

# --- Stripe (test mode, Connect/Express) ---
# Platform secret key only; the flow is a server-side redirect to Stripe Checkout,
# so there is no publishable key. Connected-account ids live per-org in the DB.
# Unset -> Checkout/Connect calls are described, and webhooks are exercised by
# feeding stored event fixtures to processStripeEvent rather than signing live
# ones.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Platform SMTP ---
# App-owned sender for invitations and organizations without a verified connector.
# Unset required credentials -> delivery returns a described send instead of transmitting.
APP_SMTP_HOST=""
APP_SMTP_PORT=""
APP_SMTP_SECURE=""
APP_SMTP_USER=""
APP_SMTP_PASSWORD=""
APP_EMAIL_FROM=""

# --- Email connector OAuth clients ---
# App-level OAuth clients only; each org picks Gmail, Microsoft 365, or SMTP
# and stores its own tokens/credentials in org settings. SMTP needs no env vars.
# Unset -> delivery returns a described send instead of transmitting.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
