ARCADE_USER_ID=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL=""

# --- Firecrawl (direct API; replaces the Arcade Firecrawl.ScrapeUrl proxy) ---
# Placeholder by default so roster sync fails loudly instead of spending credits.
# Tests should keep using the checked-in capture fixture, not the network.
FIRECRAWL_API_KEY=""
# FIRECRAWL_BASE_URL="https://api.firecrawl.dev/v2"

# --- Stripe (test mode, Connect/Express) ---
# Platform keys. Connected-account ids live per-org in the database, not here.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email connector OAuth clients ---
# App-level OAuth clients only; each org picks Gmail, Microsoft 365, or SMTP
