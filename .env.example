# Core
# The server validates the environment once at startup and reports every invalid variable together.
# NODE_ENV is set by Next.js itself and is never read from this file.
DATABASE_URL="postgresql://dogathon:dogathon@localhost:5432/dogathon?schema=public"

# Auth
# BETTER_AUTH_SECRET is at least 32 characters and must be set in production.
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# AI
# Without a key, completions are described or replaced with deterministic output.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Firecrawl
# Without a key, roster sync uses the bundled fallback capture.
FIRECRAWL_API_KEY=""
FIRECRAWL_BASE_URL="https://api.firecrawl.dev/v2"

# Scheduler
# Without the secret, scheduled roster routes reject requests.
CRON_SECRET=""

# Stripe
# Without the platform key, billing calls use their described dry-run path.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Platform SMTP
# Without a host, port, and From address, mail is described instead of sent. Auth is optional.
APP_SMTP_HOST=""
APP_SMTP_PORT=""
APP_SMTP_SECURE=""
APP_SMTP_USER=""
APP_SMTP_PASSWORD=""
APP_EMAIL_FROM=""

# Email connectors
# The encryption key is 32 random bytes encoded as base64 and is required in production.
EMAIL_CONNECTOR_ENCRYPTION_KEY=""
# Without both values for a provider, its OAuth setup is unavailable and sends are described.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Use "common" for work/school and personal accounts, or set a tenant ID.
MICROSOFT_TENANT_ID="common"
