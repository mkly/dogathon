DATABASE_URL="postgresql://dogathon:dogathon@localhost:5432/dogathon?schema=public"
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
# Optional JSON webhook that delivers {to, subject, invitationUrl, role}.
# Without it, development invitation links are logged to the server console.
INVITATION_EMAIL_WEBHOOK_URL=""
ARCADE_API_KEY=""
ARCADE_USER_ID=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY=""
OPENAI_MODEL=""

# Every key below is intentionally empty. This codebase treats an absent
# credential as "describe the call, do not make it" -- see the DryRunCall path
# in src/lib/arcade.ts and the checked-in capture fallback in
# src/lib/roster-sync.ts. Never fill these with shaped-but-invalid values: a
# present key makes the code attempt the endpoint and fail at auth instead.

# --- Firecrawl (direct API; replaces the Arcade Firecrawl.ScrapeUrl proxy) ---
# Unset -> scrape/map return a dry-run description and roster sync uses the
# bundled dogs-page-A.html capture with usedFallbackCapture: true.
FIRECRAWL_API_KEY=""
FIRECRAWL_BASE_URL="https://api.firecrawl.dev/v2"

# --- Stripe (test mode, Connect/Express) ---
# Platform keys. Connected-account ids live per-org in the database, not here.
# Unset -> Checkout/Connect calls are described, and webhooks are exercised by
# feeding stored event fixtures to the handler rather than by signing live ones.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email connector OAuth clients ---
# App-level OAuth clients only; each org picks Gmail, Microsoft 365, or SMTP
# and stores its own tokens/credentials in org settings. SMTP needs no env vars.
# Unset -> delivery returns a described send instead of transmitting.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
