generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id @default(uuid(4)) @db.Uuid
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  sponsor       Sponsor?

  username String?

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id                   String   @id @default(uuid(4)) @db.Uuid
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String   @db.Uuid
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?  @db.Uuid

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Organization {
  id                     String           @id @default(uuid(4)) @db.Uuid
  name                   String
  slug                   String
  logo                   String?
  metadata               String?
  createdAt              DateTime
  members                Member[]
  invitations            Invitation[]
  residents              Resident[]
  sponsorships           Sponsorship[]
  volunteerNotes         VolunteerNote[]
  volunteerPhotos        VolunteerPhoto[]
  pupdates               Pupdate[]
  settings               RescueSettings?
  rosterSyncNotes        RosterSyncNote[]
  emailConnector         EmailConnector?
  stripeAccountId        String?          @unique
  stripeDetailsSubmitted Boolean          @default(false)
  stripeChargesEnabled   Boolean          @default(false)

  @@unique([slug])
  @@map("organization")
}

enum EmailConnectorType {
  gmail
  microsoft
  smtp
}

model EmailConnector {
  orgId                 String             @id @db.Uuid
  type                  EmailConnectorType
  fromEmail             String
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  accessTokenExpiresAt  DateTime?
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean?
  smtpUser              String?
  smtpPasswordEncrypted String?
  verifiedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  organization          Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Member {
  id             String       @id @default(uuid(4)) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           String
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(uuid(4)) @db.Uuid
  organizationId String       @db.Uuid
  email          String
  role           String
  status         String
  inviterId      String       @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Account {
  id                    String    @id @default(uuid(4)) @db.Uuid
  issuer                String
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid(4)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ResidentStatus {
  available
  adopted
}

enum SponsorshipChannel {
  email
  sms
  both
}

enum SponsorshipStatus {
  active
  ended
}

model Sponsor {
  id           String             @id @default(uuid(4)) @db.Uuid
  email        String             @unique
  name         String
  phone        String?
  channel      SponsorshipChannel @default(email)
  userId       String?            @unique @db.Uuid
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  sponsorships Sponsorship[]
}

enum PupdateType {
  regular
  graduation
}

enum PupdateStatus {
  draft
  approved
  sent
}

model Resident {
  id              String           @id @default(uuid(4)) @db.Uuid
  orgId           String           @db.Uuid
  name            String
  breed           String
  dobText         String
  ageText         String
  sex             String
  weightText      String
  personality     String
  careNotes       String[]
  photoUrls       String[]
  status          ResidentStatus   @default(available)
  adoptedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sponsorships    Sponsorship[]
  volunteerNotes  VolunteerNote[]
  volunteerPhotos VolunteerPhoto[]
  pupdates        Pupdate[]
  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@unique([id, orgId])
  @@index([orgId, status])
}

model Sponsorship {
  id                      String            @id @default(uuid(4)) @db.Uuid
  orgId                   String            @db.Uuid
  residentId              String            @db.Uuid
  sponsorId               String            @db.Uuid
  monthlyUsd              Int               @default(25)
  status                  SponsorshipStatus @default(active)
  endedReason             String?
  endedAt                 DateTime?
  stripeCheckoutSessionId String?           @unique
  stripeSubscriptionId    String?           @unique
  stripeCustomerId        String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  organization            Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resident                Resident          @relation(fields: [residentId, orgId], references: [id, orgId], onDelete: Cascade)
  sponsor                 Sponsor           @relation(fields: [sponsorId], references: [id], onDelete: Restrict)

  @@unique([id, orgId])
  @@index([orgId, status])
  @@index([residentId, orgId, status])
  @@index([sponsorId])
}

model VolunteerNote {
  id           String           @id @default(uuid(4)) @db.Uuid
  orgId        String           @db.Uuid
  residentId   String           @db.Uuid
  note         String
  photoUrl     String?
  createdAt    DateTime         @default(now())
  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resident     Resident         @relation(fields: [residentId, orgId], references: [id, orgId], onDelete: Cascade)
  photos       VolunteerPhoto[]

  @@unique([id, orgId])
  @@index([orgId, createdAt])
  @@index([residentId, orgId, createdAt])
}

model VolunteerPhoto {
  id           String         @id @default(uuid(4)) @db.Uuid
  orgId        String         @db.Uuid
  residentId   String         @db.Uuid
  noteId       String?        @db.Uuid
  storageKey   String         @unique
  url          String
  mime         String
  byteSize     Int
  createdAt    DateTime       @default(now())
  organization Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resident     Resident       @relation(fields: [residentId, orgId], references: [id, orgId], onDelete: Cascade)
  note         VolunteerNote? @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([id, orgId])
  @@index([noteId])
  @@index([orgId, createdAt])
}

model Pupdate {
  id           String        @id @default(uuid(4)) @db.Uuid
  orgId        String        @db.Uuid
  residentId   String        @db.Uuid
  type         PupdateType   @default(regular)
  subject      String
  bodyText     String
  smsText      String
  /// The volunteer-note photo this update was written from, captured at compose
  /// time so the email never falls back to the roster's profile shot.
  photoUrl     String?
  status       PupdateStatus @default(draft)
  sentAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resident     Resident      @relation(fields: [residentId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([id, orgId])
  @@index([orgId, status])
  @@index([residentId, orgId, status])
}

model RescueSettings {
  orgId            String       @id @db.Uuid
  /// Empty until staff save an adoption-page URL; the scheduler skips empty sources.
  sourceUrl        String       @default("")
  pinnedPostscript String       @default("")
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

/// Guidance the roster discovery agent leaves for its next crawl of a source:
/// which listing and detail paths to include, how many companions to expect,
/// and site quirks. The newest note for the configured source is shown to the
/// agent so each sync stays scoped instead of rediscovering the whole site.
model RosterSyncNote {
  id           String       @id @default(uuid(4)) @db.Uuid
  orgId        String       @db.Uuid
  sourceUrl    String
  notes        String
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, sourceUrl, createdAt])
}
