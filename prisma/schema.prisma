generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  username String?

  @@unique([email])
  @@unique([username])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Organization {
  id                     String          @id
  name                   String
  slug                   String
  logo                   String?
  metadata               String?
  createdAt              DateTime
  members                Member[]
  invitations            Invitation[]
  residents              Resident[]
  sponsorships           Sponsorship[]
  volunteerNotes         VolunteerNote[]
  pupdates               Pupdate[]
  settings               RescueSettings?
  emailConnector         EmailConnector?
  stripeAccountId        String?         @unique
  stripeDetailsSubmitted Boolean         @default(false)
  stripeChargesEnabled   Boolean         @default(false)

  @@unique([slug])
  @@map("organization")
}

enum EmailConnectorType {
  gmail
  microsoft
  smtp
}

model EmailConnector {
  orgId                 String              @id
  type                  EmailConnectorType
  fromEmail             String
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  accessTokenExpiresAt  DateTime?
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean?
  smtpUser              String?
  smtpPasswordEncrypted String?
  oauthProvider         EmailConnectorType?
  oauthStateHash        String?
  oauthStateExpiresAt   DateTime?
  verifiedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  organization          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String
  status         String
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum ResidentStatus {
  available
  adopted
}

enum SponsorshipChannel {
  email
  sms
  both
}

enum SponsorshipStatus {
  active
  ended
}

enum PupdateType {
  regular
  graduation
}

enum PupdateStatus {
  draft
  approved
  sent
}

model Resident {
  id             String          @id @default(cuid())
  orgId          String
  name           String
  breed          String
  dobText        String
  ageText        String
  sex            String
  weightText     String
  personality    String
  careNotes      String[]
  photoUrls      String[]
  status         ResidentStatus  @default(available)
  adoptedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sponsorships   Sponsorship[]
  volunteerNotes VolunteerNote[]
  pupdates       Pupdate[]
  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@unique([id, orgId])
  @@index([orgId, status])
}

model Sponsorship {
  id                      String             @id @default(cuid())
  orgId                   String
  residentId              String
  sponsorName             String
  sponsorEmail            String
  sponsorPhone            String?
  channel                 SponsorshipChannel
  monthlyUsd              Int                @default(25)
  status                  SponsorshipStatus  @default(active)
  endedReason             String?
  endedAt                 DateTime?
  stripeCheckoutSessionId String?            @unique
  stripeSubscriptionId    String?            @unique
  stripeCustomerId        String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  organization            Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resident                Resident           @relation(fields: [residentId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([id, orgId])
  @@index([orgId, status])
  @@index([residentId, orgId, status])
}

model VolunteerNote {
  id           String       @id @default(cuid())
  orgId        String
  residentId   String
  note         String
  photoUrl     String?
  photoData    Bytes?
  photoMime    String?
  createdAt    DateTime     @default(now())
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resident     Resident     @relation(fields: [residentId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([id, orgId])
  @@index([orgId, createdAt])
  @@index([residentId, orgId, createdAt])
}

model Pupdate {
  id           String        @id @default(cuid())
  orgId        String
  residentId   String
  type         PupdateType   @default(regular)
  subject      String
  bodyText     String
  smsText      String
  /// The volunteer-note photo this update was written from, captured at compose
  /// time so the email never falls back to the roster's profile shot.
  photoUrl     String?
  status       PupdateStatus @default(draft)
  sentAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  resident     Resident      @relation(fields: [residentId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([id, orgId])
  @@index([orgId, status])
  @@index([residentId, orgId, status])
}

model RescueSettings {
  orgId            String       @id
  sourceUrl        String       @default("https://www.coppersdream.org/dogs-and-more-back-up")
  pinnedPostscript String       @default("")
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}
